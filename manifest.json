{
  "manifest_version": "0.4",
  "name": "ouestcharlie-woof",
  "display_name": "OuEstCharlie Woof",
  "version": "0.15.2",
  "description": "OuEstCharlie Woof — AI native photo gallery based on MCP Apps and skills",
  "author": {
    "name": "Antoine Hue"
  },
  "icon": "icon.png",
  "server": {
    "type": "uv",
    "entry_point": "pyproject_packaging.toml",
    "mcp_config": {
      "command": "uv",
      "args": ["tool", "run", "--python", "3.13", "--from", "ouestcharlie-woof==0.15.2", "woof-bridge"]
    }
  },
  "compatibility": {
    "platforms": ["darwin", "linux", "win32"],
    "runtimes": {
      "python": "3.13"
    }
  },
  "keywords": ["photos", "mcp", "ouestcharlie"],
  "license": "MIT",
  "privacy_policies": [
    "https://github.com/ouestcharlie/ouestcharlie-woof#privacy-policy"
  ]
}
